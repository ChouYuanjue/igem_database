.DS_Store
Thumbs.db

# Local runtime/download artifacts
/backend/downloads/
/blast_db/
/schema.out.txt
/schema.err.txt

# Local tooling / runtime dirs not part of the mirror
.claude/
/backend/blast_bin/
/backend/blast_work/
/backend/.env

# Generated download payloads and stray test logs
/backend/app/downloads/
/frontend/src/pw_e2e.log

# ---------------------------------------------------------------------------
# Pipeline artifacts — regenerate with update_tool/, do NOT commit.
# ---------------------------------------------------------------------------
# Raw download + segmented/merged outputs (update_tool/_src/, _merged/).
# 全量 TrEMBL 下这几个目录合计 ~700MB, 提交进去会把仓库撑爆。
/update_tool/_src/
/update_tool/_merged/
# 试点与沙箱工作区（用了 --root= 就是这几个名字）
/update_tool/_pilot*/
/update_tool/_sandbox*/
/update_tool/_sbx*/
/update_tool/_t/
/update_tool/_deploy_backup/
/update_tool/_*.md5
/update_tool/_emoji_scan.txt
# update_database.py 的落盘：分段表带来源后缀, 汇合表不带。
# 只有 3 张汇合表（terpene_pairs / terpene_compounds / all_nodes）是仓库跟踪的,
# 其余带后缀的全是流水线产物。注意上面的目录都在 update_tool/ 下。
/for_*/*.swiss_prot.tsv
/for_*/*.trembl.tsv
/for_*/*/*.swiss_prot.tsv
/for_*/*/*.trembl.tsv
# download_uniprot.py --out= 的单来源产物落在仓库根目录
/uniprotkb_terpene_parsed.*.tsv
# 探针脚本的临时快照（阈值/基线 JSON），不是代码
/_graph_*.json
/_iso_*.json
/_ab_*.json
/_pool_*.json
/st_*.json

# ---------------------------------------------------------------------------
# 仓库根目录的一次性探针脚本 + MySQL 运维脚本 + 数据库备份。
# 见 docs/wiki/database-protocol.md §2.3（开发产物清点）。
# ---------------------------------------------------------------------------
# 必须锚定到根目录: 裸 `_*.py` 会连 backend/app/models/_enums.py 和所有
# __init__.py 一起忽略掉，`_*.json` 会误伤 update_tool/_allnodes_inchikey.json
# （那个是仓库跟踪的真实数据）。
/_*.py
# 4 个 .ps1 是 MySQL 的 datadir/tmpdir/buffer-pool 运维脚本。2026-10-01 之前
# 其中两个硬编码着本机 root 密码，已改为读 $env:IGEM_DB_PASSWORD；但脚本本身
# 写死了 D:\MYSQL\、D:\MySQLData 等本机路径，且 _drop_old_datadir.ps1 会不可逆
# 删除一个 datadir —— 不进仓库。§9 第 0 步按 §3.2 的步骤做，不依赖这些脚本。
/_*.ps1
/_*.log
# 备份目录: _db_backup/ 里单个 .sql 就有 1.0GB，超 GitHub 100MB 硬限
/_db_backup/
/_dbbackup/
/_pre_merge_backup_*/
/mysqldata_copy.log
